<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XMLTester"
        x:Class="XMLTester.MainWindow"
        Title="eSocket.POS XML Tester"
        Width="740" Height="740"
        MinWidth="640" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Light">

  <Window.Styles>
    <Style Selector="Border.grp">
      <Setter Property="BorderBrush"   Value="#B0B0B0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"  Value="3"/>
      <Setter Property="Margin"        Value="6,3"/>
      <Setter Property="Padding"       Value="8,4,8,8"/>
    </Style>
    <Style Selector="TextBlock.grp-title">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin"     Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.detail-label">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin"            Value="0,3"/>
    </Style>
    <Style Selector="TextBlock.detail-value">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin"            Value="0,3"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- ── Configuration ────────────────────────────────────────────────── -->
    <Border Classes="grp" DockPanel.Dock="Top">
      <Grid RowDefinitions="Auto,Auto">
        <TextBlock Text="Configuration" Classes="grp-title" Grid.Row="0"/>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,170,16,Auto,*">
          <TextBlock Text="Terminal ID:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox   x:Name="txtTerminalId" Grid.Column="1" MaxLength="32"/>
          <TextBlock Text="Status:" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock x:Name="lblStatus" Grid.Column="4" Text="Ready" Foreground="Navy"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Grid>
    </Border>

    <!-- ── Transaction ───────────────────────────────────────────────────── -->
    <Border Classes="grp" DockPanel.Dock="Top">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Text="Transaction" Classes="grp-title" Grid.Row="0"/>

        <!-- Row 1: Amount / Cashback / Currency -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,6" VerticalAlignment="Center">
          <TextBlock Text="Amount ($):"   VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBox   x:Name="txtAmount"   Width="82" Text="1.00" TextAlignment="Right"
                     Margin="0,0,14,0" LostFocus="AmountBox_LostFocus" GotFocus="AmountBox_GotFocus"/>
          <TextBlock Text="Cashback ($):" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBox   x:Name="txtCashback" Width="82" TextAlignment="Right"
                     Margin="0,0,14,0" LostFocus="AmountBox_LostFocus" GotFocus="AmountBox_GotFocus"/>
          <TextBlock Text="Currency:"     VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox  x:Name="cmbCurrency" Width="90"/>
        </WrapPanel>

        <!-- Row 2: Action buttons -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
          <Button x:Name="btnInit"     Content="Init"     Width="68" Margin="0,0,4,0"
                  Click="BtnInit_Click"/>
          <Button x:Name="btnPurchase" Content="Purchase" Width="88" Margin="0,0,4,0"
                  FontWeight="Bold" IsEnabled="False" Click="BtnPurchase_Click"/>
          <Button x:Name="btnBalance"  Content="Balance"  Width="80" Margin="0,0,4,0"
                  IsEnabled="False" Click="BtnBalance_Click"/>
          <Button x:Name="btnClose"    Content="Close"    Width="68" Margin="0,0,4,0"
                  IsEnabled="False" Click="BtnClose_Click"/>
          <Button x:Name="btnReversal" Content="Reversal" Width="84" Margin="0,0,4,0"
                  IsEnabled="False" Foreground="DarkOrange" Click="BtnReversal_Click"/>
          <Button x:Name="btnChange"   Content="Change ↓" Width="88" Margin="0,0,4,0"
                  IsEnabled="False" Foreground="DarkSlateBlue" Click="BtnChange_Click"/>
          <Button x:Name="btnClear"    Content="Clear"    Width="68" Margin="60,0,0,0"
                  Foreground="DimGray" Click="BtnClear_Click"/>
        </WrapPanel>

        <!-- Row 3: RRN -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="chkRrn"     Content="Send RRN"   VerticalAlignment="Center"
                    Margin="0,0,8,0" IsCheckedChanged="ChkRrn_IsCheckedChanged"/>
          <TextBox  x:Name="txtRrn"     Width="228"           IsEnabled="False"
                    FontFamily="Consolas,Courier New,monospace" FontSize="11.5"
                    MaxLength="12" Margin="0,0,8,0"/>
          <Button   x:Name="btnRegenRrn" Content="Regenerate" IsEnabled="False"
                    Width="90" Click="BtnRegenRrn_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Outcome + Details (bottom, fixed height) ──────────────────────── -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="6,3,6,4" Height="190">

      <!-- Outcome -->
      <Border Grid.Column="0" Classes="grp" Margin="0,0,3,0">
        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Text="Transaction Outcome" Classes="grp-title" Grid.Row="0" Grid.ColumnSpan="2"/>

          <TextBlock Text="Outcome:"            Grid.Row="1" Grid.Column="0" Classes="detail-label"/>
          <TextBlock x:Name="lblOutcome"        Grid.Row="1" Grid.Column="1" Text="—"
                     FontSize="13" FontWeight="Bold" Classes="detail-value"/>

          <TextBlock Text="Response Code:"      Grid.Row="2" Grid.Column="0" Classes="detail-label" Margin="0,6,0,0"/>
          <TextBlock x:Name="lblResponseCode"   Grid.Row="2" Grid.Column="1" Text="—"
                     Classes="detail-value" Margin="0,6,0,0"/>

          <TextBlock Text="Response Message:"   Grid.Row="3" Grid.Column="0" Classes="detail-label"/>
          <TextBlock x:Name="lblResponseMsg"    Grid.Row="3" Grid.Column="1" Text="—"
                     Classes="detail-value" TextWrapping="Wrap"/>

          <TextBlock Text="Reason Code (MRC):"  Grid.Row="4" Grid.Column="0" Classes="detail-label"/>
          <TextBlock x:Name="lblReasonCode"     Grid.Row="4" Grid.Column="1" Text="—"
                     Classes="detail-value" TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <!-- Transaction Details -->
      <Border Grid.Column="1" Classes="grp" Margin="3,0,0,0">
        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Text="Transaction Details"  Classes="grp-title" Grid.Row="0" Grid.ColumnSpan="2"/>

          <TextBlock Text="Terminal ID:"         Grid.Row="1" Grid.Column="0" Classes="detail-label"/>
          <TextBlock x:Name="lblTxTermId"        Grid.Row="1" Grid.Column="1" Text="—" Classes="detail-value"/>

          <TextBlock Text="Retrieval Ref Num:"   Grid.Row="2" Grid.Column="0" Classes="detail-label"/>
          <TextBlock x:Name="lblTxRrn"           Grid.Row="2" Grid.Column="1" Text="—"
                     FontFamily="Consolas,monospace" FontSize="11" Classes="detail-value"/>

          <TextBlock Text="Card Number:"         Grid.Row="3" Grid.Column="0" Classes="detail-label"/>
          <TextBlock x:Name="lblTxCard"          Grid.Row="3" Grid.Column="1" Text="—"
                     FontFamily="Consolas,monospace" FontSize="11" Classes="detail-value"/>

          <TextBlock Text="Date and Time:"       Grid.Row="4" Grid.Column="0" Classes="detail-label"/>
          <TextBlock x:Name="lblTxDateTime"      Grid.Row="4" Grid.Column="1" Text="—" Classes="detail-value"/>

          <TextBlock Text="Method:"              Grid.Row="5" Grid.Column="0" Classes="detail-label"/>
          <TextBlock x:Name="lblTxMethod"        Grid.Row="5" Grid.Column="1" Text="—" Classes="detail-value"/>

          <TextBlock Text="Response:"            Grid.Row="6" Grid.Column="0" Classes="detail-label"/>
          <TextBlock x:Name="lblTxResponse"      Grid.Row="6" Grid.Column="1" Text="—"
                     TextWrapping="Wrap" Classes="detail-value"/>

          <TextBlock Text="Amount:"              Grid.Row="7" Grid.Column="0" Classes="detail-label"/>
          <TextBlock x:Name="lblTxAmount"        Grid.Row="7" Grid.Column="1" Text="—"
                     FontWeight="Bold" Classes="detail-value"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ── Tab control (fills remaining space) ───────────────────────────── -->
    <TabControl Margin="6,0,6,0">
      <TabItem Header="  Events  ">
        <ScrollViewer x:Name="eventsScroll" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="lstEvents">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}"
                           Foreground="{Binding Foreground}"
                           FontFamily="Consolas,Courier New,monospace"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Margin="0,0,0,1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="  XML Sent  ">
        <TextBox x:Name="txtXmlSent"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"
                 FontFamily="Consolas,Courier New,monospace"
                 FontSize="11.5"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </TabItem>

      <TabItem Header="  XML Received  ">
        <TextBox x:Name="txtXmlReceived"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"
                 FontFamily="Consolas,Courier New,monospace"
                 FontSize="11.5"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>

  </DockPanel>
</Window>
